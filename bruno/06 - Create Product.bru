meta {
  name: 06 - Create Product
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bruno Certified Mechanical Switchpad",
    "description": "Ergonomic numpad and macro keyboard for developers and testers.",
    "price": 59.99,
    "category": "Accessories",
    "stockQuantity": 40,
    "inStock": true
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.name: eq Bruno Certified Mechanical Switchpad
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("createdProductId", res.body.id);
  }
}

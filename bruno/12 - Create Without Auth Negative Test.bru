meta {
  name: 12 - Create Without Auth Negative Test
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: none
}

body:json {
  {
    "name": "Should Fail Item",
    "price": 20,
    "category": "Testing"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq Unauthorized
}

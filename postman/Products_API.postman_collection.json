{
  "info": {
    "_postman_id": "b1a2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "Product Catalog API - Complete Test Suite",
    "description": "Comprehensive test collection covering RESTful endpoints, JWT Bearer authentication, pagination, CRUD lifecycle, schema validation, and negative security testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health & Specs",
      "item": [
        {
          "name": "GET API Health & Dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has healthy status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"online\");",
                  "    pm.expect(jsonData.version).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET OpenAPI Specification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": ["{{baseUrl}}"],
              "path": ["openapi.json"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Valid OpenAPI 3.0 specification\", function () {",
                  "    var schema = pm.response.json();",
                  "    pm.expect(schema.openapi).to.match(/^3\\./);",
                  "    pm.expect(schema.paths).to.be.an(\"object\");",
                  "    pm.expect(schema.paths).to.have.property(\"/api/v1/products\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "POST Login - Success (Generates & Stores Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains valid bearer token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"token\");",
                  "    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");",
                  "    ",
                  "    // Dynamic variable persistence: save token for subsequent requests",
                  "    pm.environment.set(\"bearerToken\", jsonData.token);",
                  "    console.log(\"Saved bearerToken to environment:\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Login - Bad Credentials (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrongPassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Returns structured error message\", function () {",
                  "    var err = pm.response.json();",
                  "    pm.expect(err.error).to.eql(\"Unauthorized\");",
                  "    pm.expect(err.status).to.eql(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Products CRUD Flow",
      "item": [
        {
          "name": "GET All Products (Default Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response format includes items array and pagination\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.items).to.be.an(\"array\");",
                  "    pm.expect(jsonData.items.length).to.be.above(0);",
                  "    pm.expect(jsonData.pagination).to.have.property(\"total\");",
                  "    pm.expect(jsonData.pagination.page).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"Latency is within acceptable bounds (< 300ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(300);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Products with Query Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?category=Audio&limit=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "category", "value": "Audio" },
                { "key": "limit", "value": "2" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Filter and limit strictly applied\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.items.length).to.be.at.most(2);",
                  "    jsonData.items.forEach(function(item) {",
                  "        pm.expect(item.category).to.eql(\"Audio\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create Product (Requires Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart Wireless ANC Earbuds\",\n  \"description\": \"Bluetooth 5.3 earbuds with active transparency mode and wireless charging case.\",\n  \"price\": 149.99,\n  \"category\": \"Audio\",\n  \"stockQuantity\": 50,\n  \"inStock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Location header is present\", function () {",
                  "    pm.response.to.have.header(\"Location\");",
                  "});",
                  "",
                  "pm.test(\"Created product has ID and matches input\", function () {",
                  "    var prod = pm.response.json();",
                  "    pm.expect(prod.id).to.be.a(\"string\");",
                  "    pm.expect(prod.name).to.eql(\"Smart Wireless ANC Earbuds\");",
                  "    pm.expect(prod.price).to.eql(149.99);",
                  "    ",
                  "    // Save ID dynamically for chaining next tests",
                  "    pm.environment.set(\"createdProductId\", prod.id);",
                  "    console.log(\"Saved createdProductId:\", prod.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Product By ID (Chained Test)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{createdProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{createdProductId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Fetched product matches ID\", function () {",
                  "    var prod = pm.response.json();",
                  "    pm.expect(prod.id).to.eql(pm.environment.get(\"createdProductId\"));",
                  "    pm.expect(prod.name).to.eql(\"Smart Wireless ANC Earbuds\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart Wireless ANC Earbuds (Gen 2)\",\n  \"price\": 129.99,\n  \"stockQuantity\": 75\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{createdProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{createdProductId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Product updated attributes reflected\", function () {",
                  "    var updated = pm.response.json();",
                  "    pm.expect(updated.name).to.eql(\"Smart Wireless ANC Earbuds (Gen 2)\");",
                  "    pm.expect(updated.price).to.eql(129.99);",
                  "    pm.expect(updated.stockQuantity).to.eql(75);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Catalog Statistics (Authenticated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Valid aggregate statistics returned\", function () {",
                  "    var stats = pm.response.json();",
                  "    pm.expect(stats.totalProducts).to.be.above(0);",
                  "    pm.expect(stats.totalInventoryValue).to.be.above(0);",
                  "    pm.expect(stats.categories).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE Product by ID",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{createdProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{createdProductId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Success confirmation received\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.id).to.eql(pm.environment.get(\"createdProductId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Deleted Product (Verify 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{createdProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{createdProductId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found after deletion\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error schema conforms to standard\", function () {",
                  "    var err = pm.response.json();",
                  "    pm.expect(err.status).to.eql(404);",
                  "    pm.expect(err.error).to.eql(\"Not Found\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Security & Negative Tests",
      "item": [
        {
          "name": "POST Create Product - Missing Auth Token (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized Item\",\n  \"price\": 10.00,\n  \"category\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Error specifies missing or invalid auth token\", function () {",
                  "    var err = pm.response.json();",
                  "    pm.expect(err.status).to.eql(401);",
                  "    pm.expect(err.message).to.include(\"Bearer\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create Product - Validation Error (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": -50,\n  \"category\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error identifies validation failure\", function () {",
                  "    var err = pm.response.json();",
                  "    pm.expect(err.status).to.eql(400);",
                  "    pm.expect(err.error).to.eql(\"Bad Request\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Non-Existent Product (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/non-existent-id-99999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "non-existent-id-99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}